    @template tool_teachermcp/dashboard_prompts
    Example context (json):
    {
        "invalid_course": false, "has_courses": true,
        "course_form_url": "/admin/tool/teachermcp/my_agent.php#teacher-prompts",
        "selected_client": "claude", "selected_course": {"id": 2, "fullname": "Example course"},
        "courses": [{"id": 2, "fullname": "Example course", "selected": true}],
        "prompt_categories": [{
            "id": "prompts-context", "category": "Context", "count": 1,
            "items": [{
                "id": "prompt-ingest", "textid": "prompt-ingest-text", "title": "Summarise course",
                "description": "Review course content.", "copy_label": "Copy summarise course prompt",
                "copy_target": false, "prompt": "Summarise this course."
            }]
        }]
    }
}}
<section id="teacher-prompts" class="mb-4 pt-3 border-top">
    <h2 class="h4">{{#str}}dashboard_tasks, tool_teachermcp{{/str}}</h2>
    {{#invalid_course}}<div class="alert alert-warning" role="alert">{{#str}}dashboard_course_unavailable, tool_teachermcp{{/str}}</div>{{/invalid_course}}
    {{#has_courses}}
    <form id="promptCourseForm" action="{{course_form_url}}" method="get" data-preserve-client class="mb-3">
        <input type="hidden" name="client" value="{{selected_client}}">
        <label for="promptCourseFilter" class="font-weight-bold">{{#str}}course_filter_label, tool_teachermcp{{/str}}</label>
        <div class="d-flex flex-wrap align-items-center tool_teachermcp_actions">
            <select id="promptCourseFilter" name="courseid" class="custom-select form-control tool_teachermcp_course_select" required>
                <option value="" disabled {{^selected_course}}selected{{/selected_course}} label="{{#str}}course_filter_all, tool_teachermcp{{/str}}"></option>
                {{#courses}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{fullname}}</option>{{/courses}}
            </select>
            <button type="submit" class="btn btn-secondary">{{#str}}use_course, tool_teachermcp{{/str}}</button>
        </div>
    </form>
    {{/has_courses}}
    {{^has_courses}}<p class="text-muted">{{#str}}dashboard_no_courses, tool_teachermcp{{/str}}</p>{{/has_courses}}
    {{#selected_course}}
    <p>{{#str}}prompt_library_desc, tool_teachermcp{{/str}}</p>
    {{#prompt_categories}}
    <details id="{{id}}" class="tool_teachermcp_prompt_group border-bottom py-2">
        <summary class="font-weight-bold">{{category}} ({{count}})</summary>
        {{#items}}
        {{> tool_teachermcp/prompt_item}}
        {{/items}}
    </details>
    {{/prompt_categories}}
    {{/selected_course}}
</section>
