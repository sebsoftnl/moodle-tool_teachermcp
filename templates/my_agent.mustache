{{!
    @template tool_teachermcp/my_agent
    Teacher MCP agent connection dashboard.
}}
<div class="tool_teachermcp_dashboard">
    <!-- Header Block -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card bg-light border-0">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between mb-2">
                        <h2 class="card-title h3 mb-0 text-dark">
                            <i class="fa fa-robot mr-2 me-2 text-primary"></i>{{#str}}dashboard_title, tool_teachermcp{{/str}}
                        </h2>
                        <span class="badge badge-primary text-white px-3 py-2 mt-2 mt-sm-0">
                            {{tools_count_badge}}
                        </span>
                    </div>
                    <p class="card-text text-muted mb-3">
                        {{#str}}dashboard_desc, tool_teachermcp{{/str}}
                    </p>
                    <div class="bg-white border rounded p-2 px-3 d-flex flex-wrap align-items-center justify-content-between">
                        <div class="d-flex align-items-center my-1">
                            <span class="font-weight-bold text-secondary mr-2 me-2">
                                <i class="fa fa-link mr-1 me-1"></i>{{#str}}endpoint_url, tool_teachermcp{{/str}}:
                            </span>
                            <code class="text-primary font-weight-bold user-select-all" id="endpointDisplay">{{endpoint_url}}</code>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary my-1" onclick="navigator.clipboard.writeText('{{endpoint_url}}'); var b=this; b.innerHTML='<i class=\'fa fa-check\'></i> {{#str}}copied, tool_teachermcp{{/str}}'; setTimeout(function(){ b.innerHTML='<i class=\'fa fa-copy\'></i> {{#str}}copy, tool_teachermcp{{/str}}'; }, 2000);">
                            <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy, tool_teachermcp{{/str}}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Newly Created Token Notification -->
    {{#new_token}}
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-warning border shadow-sm">
                <h4 class="alert-heading h5 mb-2">
                    <i class="fa fa-key mr-2 me-2 text-warning"></i>{{#str}}token_created, tool_teachermcp{{/str}}
                </h4>
                <p class="small mb-3">{{#str}}token_warning, tool_teachermcp{{/str}}</p>
                <div class="input-group">
                    <input type="text" class="form-control font-monospace font-weight-bold bg-white" id="newlyGeneratedToken" value="{{new_token}}" readonly>
                    <div class="input-group-append">
                        <button class="btn btn-dark" type="button" onclick="navigator.clipboard.writeText(document.getElementById('newlyGeneratedToken').value); var b=this; b.innerHTML='<i class=\'fa fa-check\'></i> {{#str}}copied, tool_teachermcp{{/str}}'; setTimeout(function(){ b.innerHTML='<i class=\'fa fa-copy\'></i> {{#str}}copy_token, tool_teachermcp{{/str}}'; }, 2000);">
                            <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy_token, tool_teachermcp{{/str}}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/new_token}}

    <!-- Main Workspace (2 columns) -->
    <div class="row">
        <!-- Tokens Column -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100 border">
                <div class="card-header bg-transparent font-weight-bold d-flex justify-content-between align-items-center py-3">
                    <span class="h6 mb-0 text-dark">
                        <i class="fa fa-shield-alt mr-2 me-2 text-secondary"></i>{{#str}}tokens_header, tool_teachermcp{{/str}}
                    </span>
                </div>
                <div class="card-body p-0">
                    <!-- Create Form inside subtle well -->
                    <div class="p-3 bg-light border-bottom">
                        <h6 class="font-weight-bold mb-3 text-secondary">{{#str}}create_token, tool_teachermcp{{/str}}</h6>
                        <form method="post" action="">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="create">
                            <div class="form-group mb-2">
                                <label for="agentname" class="small font-weight-bold text-muted mb-1">{{#str}}agent_name, tool_teachermcp{{/str}}</label>
                                <input type="text" name="agentname" id="agentname" class="form-control form-control-sm bg-white" placeholder="{{#str}}agent_name_help, tool_teachermcp{{/str}}" required>
                            </div>
                            <div class="form-group mb-3">
                                <label for="validity" class="small font-weight-bold text-muted mb-1">{{#str}}validity_period, tool_teachermcp{{/str}}</label>
                                <select name="validity" id="validity" class="form-control form-control-sm custom-select bg-white">
                                    <option value="30">{{#str}}validity_30, tool_teachermcp{{/str}}</option>
                                    <option value="90" selected>{{#str}}validity_90, tool_teachermcp{{/str}}</option>
                                    <option value="180">{{#str}}validity_180, tool_teachermcp{{/str}}</option>
                                    <option value="365">{{#str}}validity_365, tool_teachermcp{{/str}}</option>

                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fa fa-plus-circle mr-1 me-1"></i>{{#str}}create_token, tool_teachermcp{{/str}}
                            </button>
                        </form>
                    </div>

                    <!-- Tokens List -->
                    {{#has_tokens}}
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0 small">
                            <thead>
                                <tr>
                                    <th>{{#str}}agent_name, tool_teachermcp{{/str}}</th>
                                    <th>Token</th>
                                    <th>{{#str}}lastaccess, tool_teachermcp{{/str}}</th>
                                    <th>{{#str}}status, tool_teachermcp{{/str}}</th>
                                    <th class="text-right text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#tokens}}
                                <tr>
                                    <td class="font-weight-bold align-middle">{{name}}</td>
                                    <td class="align-middle"><code>...{{lastchars}}</code></td>
                                    <td class="align-middle text-muted">{{lastaccess}}</td>
                                    <td class="align-middle">
                                        {{#status_active}}
                                        <span class="badge badge-success">{{#str}}status_active, tool_teachermcp{{/str}}</span>
                                        {{/status_active}}
                                        {{^status_active}}
                                        <span class="badge badge-secondary">{{#str}}status_revoked, tool_teachermcp{{/str}}</span>
                                        {{/status_active}}
                                    </td>
                                    <td class="align-middle text-right text-end">
                                        {{#status_active}}
                                        <a href="{{revokelink}}" class="btn btn-outline-danger btn-sm py-0 px-2" title="{{#str}}revoke, tool_teachermcp{{/str}}" onclick="return confirm('{{#str}}confirm_revoke, tool_teachermcp{{/str}}');">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                        {{/status_active}}
                                    </td>
                                </tr>
                                {{/tokens}}
                            </tbody>
                        </table>
                    </div>
                    {{/has_tokens}}
                    {{^has_tokens}}
                    <div class="p-4 text-center text-muted">
                        <i class="fa fa-key fa-2x mb-2 text-muted"></i>
                        <p class="mb-0">{{#str}}no_tokens_found, tool_teachermcp{{/str}}</p>
                    </div>
                    {{/has_tokens}}
                </div>
            </div>
        </div>

        <!-- Setup Guides Column -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100 border">
                <div class="card-header bg-transparent py-2">
                    <ul class="nav nav-tabs card-header-tabs" id="agentTabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="oauth-tab" data-toggle="tab" data-bs-toggle="tab" href="#oauth" role="tab">
                                <i class="fa fa-bolt text-warning mr-1 me-1"></i>{{#str}}oauth_tab_title, tool_teachermcp{{/str}}
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="claude-tab" data-toggle="tab" data-bs-toggle="tab" href="#claude" role="tab">{{#str}}tab_claude, tool_teachermcp{{/str}}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="codex-tab" data-toggle="tab" data-bs-toggle="tab" href="#codex" role="tab">{{#str}}tab_codex, tool_teachermcp{{/str}}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="chatgpt-tab" data-toggle="tab" data-bs-toggle="tab" href="#chatgpt" role="tab">{{#str}}tab_chatgpt, tool_teachermcp{{/str}}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link font-weight-bold" id="skill-tab" data-toggle="tab" data-bs-toggle="tab" href="#skilltab" role="tab">
                                <i class="fa fa-graduation-cap mr-1 me-1 text-primary"></i>{{#str}}tab_agent_instructions, tool_teachermcp{{/str}}
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content" id="agentTabContent">
                        <!-- OAuth 2.0 Tab (Recommended) -->
                        <div class="tab-pane fade show active" id="oauth" role="tabpanel">
                            <h6 class="font-weight-bold text-dark">{{#str}}oauth_setup_title, tool_teachermcp{{/str}}</h6>
                            <p class="small text-muted mb-3">{{#str}}oauth_setup_desc, tool_teachermcp{{/str}}</p>

                            <!-- Step 1: Download Bridge -->
                            <div class="p-3 bg-light rounded border mb-3">
                                <h6 class="font-weight-bold small text-dark mb-1">
                                    <i class="fa fa-download text-primary mr-1 me-1"></i>{{#str}}download_bridge_title, tool_teachermcp{{/str}}
                                </h6>
                                <p class="small text-muted mb-2">{{#str}}download_bridge_desc, tool_teachermcp{{/str}}</p>
                                <a href="{{download_bridge_url}}" class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-download mr-1 me-1"></i>{{#str}}download_bridge_btn, tool_teachermcp{{/str}}
                                </a>
                            </div>

                            <!-- Step 2: Configure Claude Desktop -->
                            <p class="small font-weight-bold text-secondary mb-1">2. {{#str}}claude_oauth_bridge_desc, tool_teachermcp{{/str}}</p>
                            <pre class="bg-light border rounded p-3 text-break small font-monospace mb-2" id="claudeOAuthConfigBlock"><code>{{config_claude_oauth}}</code></pre>
                            <button class="btn btn-sm btn-primary mb-3" onclick="navigator.clipboard.writeText(document.getElementById('claudeOAuthConfigBlock').innerText); var b=this; b.innerHTML='<i class=\'fa fa-check\'></i> {{#str}}copied, tool_teachermcp{{/str}}'; setTimeout(function(){ b.innerHTML='<i class=\'fa fa-copy\'></i> {{#str}}copy_claude_config, tool_teachermcp{{/str}}'; }, 2000);">
                                <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy_claude_config, tool_teachermcp{{/str}}
                            </button>

                            <div class="border-top pt-2 mt-2">
                                <h6 class="small font-weight-bold text-muted mb-2">{{#str}}oauth_endpoints_title, tool_teachermcp{{/str}}</h6>
                                <div class="small text-muted mb-1">
                                    <strong>{{#str}}oauth_auth_endpoint, tool_teachermcp{{/str}}:</strong><br>
                                    <code>{{oauth_auth_url}}</code>
                                </div>
                                <div class="small text-muted mb-1">
                                    <strong>{{#str}}oauth_token_endpoint, tool_teachermcp{{/str}}:</strong><br>
                                    <code>{{oauth_token_url}}</code>
                                </div>
                                <div class="small text-muted">
                                    <strong>{{#str}}oauth_metadata_endpoint, tool_teachermcp{{/str}}:</strong><br>
                                    <code>{{oauth_meta_url}}</code>
                                </div>
                            </div>
                        </div>

                        <!-- Claude Desktop Tab -->
                        <div class="tab-pane fade" id="claude" role="tabpanel">
                            <h6 class="font-weight-bold">{{#str}}claude_desktop_title, tool_teachermcp{{/str}}</h6>
                            <p class="small text-muted mb-3">{{#str}}claude_desktop_desc, tool_teachermcp{{/str}}</p>

                            <!-- Download Bridge -->
                            <div class="p-3 bg-light rounded border mb-3">
                                <h6 class="font-weight-bold small text-dark mb-1">
                                    <i class="fa fa-download text-primary mr-1 me-1"></i>{{#str}}download_bridge_title, tool_teachermcp{{/str}}
                                </h6>
                                <p class="small text-muted mb-2">{{#str}}download_bridge_desc, tool_teachermcp{{/str}}</p>
                                <a href="{{download_bridge_url}}" class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-download mr-1 me-1"></i>{{#str}}download_bridge_btn, tool_teachermcp{{/str}}
                                </a>
                            </div>

                            <p class="small font-weight-bold text-secondary mb-1">2. {{#str}}claude_oauth_bridge_desc, tool_teachermcp{{/str}}</p>
                            <pre class="bg-light border rounded p-3 text-break small font-monospace mb-2" id="claudeConfigBlock"><code>{{config_claude}}</code></pre>
                            <button class="btn btn-sm btn-outline-secondary" onclick="navigator.clipboard.writeText(document.getElementById('claudeConfigBlock').innerText); var b=this; b.innerHTML='<i class=\'fa fa-check\'></i> {{#str}}copied, tool_teachermcp{{/str}}'; setTimeout(function(){ b.innerHTML='<i class=\'fa fa-copy\'></i> {{#str}}copy_claude_config, tool_teachermcp{{/str}}'; }, 2000);">
                                <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy_claude_config, tool_teachermcp{{/str}}
                            </button>
                        </div>

                        <!-- Codex / Cursor Tab -->
                        <div class="tab-pane fade" id="codex" role="tabpanel">
                            <h6 class="font-weight-bold">{{#str}}codex_cursor_title, tool_teachermcp{{/str}}</h6>
                            <p class="small text-muted mb-2">{{#str}}codex_cursor_desc, tool_teachermcp{{/str}}</p>
                            <pre class="bg-light border rounded p-3 text-break small font-monospace mb-2" id="codexConfigBlock"><code>{{config_codex}}</code></pre>
                            <button class="btn btn-sm btn-outline-secondary" onclick="navigator.clipboard.writeText(document.getElementById('codexConfigBlock').innerText); var b=this; b.innerHTML='<i class=\'fa fa-check\'></i> {{#str}}copied, tool_teachermcp{{/str}}'; setTimeout(function(){ b.innerHTML='<i class=\'fa fa-copy\'></i> {{#str}}copy_codex_config, tool_teachermcp{{/str}}'; }, 2000);">
                                <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy_codex_config, tool_teachermcp{{/str}}
                            </button>
                        </div>

                        <!-- ChatGPT Tab -->
                        <div class="tab-pane fade" id="chatgpt" role="tabpanel">
                            <h6 class="font-weight-bold">{{#str}}chatgpt_title, tool_teachermcp{{/str}}</h6>
                            <ol class="small text-muted pl-3 ps-3">
                                <li class="mb-1">{{#str}}chatgpt_step1, tool_teachermcp{{/str}}</li>
                                <li class="mb-1">{{#str}}chatgpt_step2, tool_teachermcp{{/str}}</li>
                                <li class="mb-1">{{chatgpt_step3_text}}</li>
                                <li class="mb-1">{{#str}}chatgpt_step4, tool_teachermcp{{/str}}</li>
                            </ol>
                        </div>

                        <!-- AI Agent Skill & Instructions Tab -->
                        <div class="tab-pane fade" id="skilltab" role="tabpanel">
                            <h6 class="font-weight-bold text-dark">{{#str}}agent_skill_title, tool_teachermcp{{/str}}</h6>
                            <p class="small text-muted mb-3">{{#str}}agent_skill_subtitle, tool_teachermcp{{/str}}</p>

                            <div class="mb-3 d-flex flex-wrap gap-2">
                                <a href="{{download_skill_url}}" class="btn btn-sm btn-outline-primary mr-2 me-2">
                                    <i class="fa fa-download mr-1 me-1"></i>{{#str}}download_skill_file, tool_teachermcp{{/str}}
                                </a>
                                <button class="btn btn-sm btn-primary" onclick="navigator.clipboard.writeText(document.getElementById('agentSystemPromptBlock').innerText); var b=this; b.innerHTML='<i class=\'fa fa-check\'></i> {{#str}}copied, tool_teachermcp{{/str}}'; setTimeout(function(){ b.innerHTML='<i class=\'fa fa-copy\'></i> {{#str}}copy_skill_prompt, tool_teachermcp{{/str}}'; }, 2000);">
                                    <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy_skill_prompt, tool_teachermcp{{/str}}
                                </button>
                            </div>

                            <pre class="bg-light border rounded p-3 text-break small font-monospace" style="max-height: 380px; overflow-y: auto;" id="agentSystemPromptBlock"><code>{{system_prompt_content}}</code></pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Teacher Prompt Library -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border">
                <div class="card-header bg-transparent d-flex flex-wrap justify-content-between align-items-center py-3">
                    <h5 class="h6 mb-0 font-weight-bold text-dark">
                        <i class="fa fa-lightbulb mr-2 me-2 text-warning"></i>{{#str}}prompt_library_title, tool_teachermcp{{/str}}
                    </h5>
                    {{#has_courses}}
                    <div class="d-flex align-items-center mt-2 mt-sm-0">
                        <label for="promptCourseFilter" class="small font-weight-bold text-muted mr-2 me-2 mb-0">
                            {{#str}}course_filter_label, tool_teachermcp{{/str}}
                        </label>
                        <select id="promptCourseFilter" class="custom-select custom-select-sm form-control form-control-sm bg-white" onchange="window.location.href='?courseid='+this.value;">
                            {{#courses}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{fullname}}</option>
                            {{/courses}}
                        </select>
                    </div>
                    {{/has_courses}}
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-4">
                        {{#str}}prompt_library_desc, tool_teachermcp{{/str}}
                    </p>

                    <div class="row">
                        {{#prompt_categories}}
                        <div class="col-lg-6 mb-4">
                            <div class="card h-100 border bg-light">
                                <div class="card-header bg-white font-weight-bold d-flex justify-content-between align-items-center py-2">
                                    <span class="text-dark"><i class="fa {{icon}} text-secondary mr-2 me-2"></i>{{category}}</span>
                                    <span class="badge badge-secondary font-weight-normal small">{{badge}}</span>
                                </div>
                                <div class="card-body p-3">
                                    {{#items}}
                                    <div class="mb-3 p-3 bg-white rounded border">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <strong class="text-dark small">{{title}}</strong>
                                            <button class="btn btn-sm btn-outline-secondary py-0 px-2 ml-2 ms-2" type="button" onclick="navigator.clipboard.writeText(this.getAttribute('data-prompt')); var b=this; b.innerHTML='<i class=\'fa fa-check\'></i> {{#str}}copied, tool_teachermcp{{/str}}'; setTimeout(function(){ b.innerHTML='<i class=\'fa fa-copy\'></i> {{#str}}copy, tool_teachermcp{{/str}}'; }, 2000);" data-prompt="{{prompt}}">
                                                <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy, tool_teachermcp{{/str}}
                                            </button>
                                        </div>
                                        <p class="text-muted small mb-2">{{description}}</p>
                                        <div class="bg-light p-2 rounded small text-monospace text-secondary font-italic border" style="font-size: 0.8rem; line-height: 1.35;">
                                            "{{prompt}}"
                                        </div>
                                    </div>
                                    {{/items}}
                                </div>
                            </div>
                        </div>
                        {{/prompt_categories}}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Return to course navigation -->
    {{#return_url}}
    <div class="row mt-2 mb-4">
        <div class="col-12">
            <a href="{{return_url}}" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left mr-1 me-1"></i>{{#str}}back_to_course, tool_teachermcp{{/str}}
            </a>
        </div>
    </div>
    {{/return_url}}
</div>
