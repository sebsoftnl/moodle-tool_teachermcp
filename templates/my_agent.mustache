{{!
    @template tool_teachermcp/my_agent
    Teacher MCP agent connection dashboard.
}}
<div class="tool_teachermcp_dashboard container-fluid"
     data-copy-success="{{#str}}copied, tool_teachermcp{{/str}}"
     data-copy-failure="{{#str}}copy_failed, tool_teachermcp{{/str}}">
    <!-- Header Block -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card bg-light border-0">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between mb-2">
                        <h2 class="card-title h3 mb-0 text-dark">
                            <i class="fa fa-robot mr-2 me-2 text-primary"></i>{{#str}}dashboard_title, tool_teachermcp{{/str}}
                        </h2>
                        <span class="badge badge-primary text-white px-3 py-2 mt-2 mt-sm-0">
                            {{tools_count_badge}}
                        </span>
                    </div>
                    <p class="card-text text-muted mb-3">
                        {{#str}}dashboard_desc, tool_teachermcp{{/str}}
                    </p>
                    <div class="bg-white border rounded p-2 px-3 d-flex flex-wrap align-items-center justify-content-between">
                        <div class="d-flex flex-wrap align-items-center my-1">
                            <span class="font-weight-bold text-body mr-2 me-2">
                                <i class="fa fa-link mr-1 me-1"></i>{{#str}}endpoint_url, tool_teachermcp{{/str}}:
                            </span>
                            <code class="text-primary font-weight-bold user-select-all" id="endpointDisplay">{{endpoint_url}}</code>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary my-1" data-copy-target="endpointDisplay">
                            <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy, tool_teachermcp{{/str}}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Newly Created Token Notification -->
    {{#new_token}}
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-warning border shadow-sm">
                <h4 class="alert-heading h5 mb-2">
                    <i class="fa fa-key mr-2 me-2 text-warning"></i>{{#str}}token_created, tool_teachermcp{{/str}}
                </h4>
                <p class="small mb-3">{{#str}}token_warning, tool_teachermcp{{/str}}</p>
                <div class="input-group">
                    <input type="text" class="form-control font-monospace font-weight-bold bg-white" id="newlyGeneratedToken" value="{{new_token}}" readonly>
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="button" data-copy-target="newlyGeneratedToken">
                            <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy_token, tool_teachermcp{{/str}}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/new_token}}

    <!-- Main Workspace (2 columns) -->
    <div class="row">
        <!-- Tokens Column -->
        <div class="col-xl-6 mb-4">
            <div class="card h-100 border">
                <div class="card-header bg-transparent font-weight-bold d-flex justify-content-between align-items-center py-3">
                    <h2 class="h6 mb-0 font-weight-bold text-body">
                        <i class="fa fa-shield-alt mr-2 me-2 text-secondary"></i>{{#str}}tokens_header, tool_teachermcp{{/str}}
                    </h2>
                </div>
                <div class="card-body p-0">
                    <!-- Create Form inside subtle well -->
                    <div class="p-3 bg-light border-bottom">
                        <h3 class="h6 font-weight-bold mb-3 text-body">{{#str}}create_token, tool_teachermcp{{/str}}</h3>
                        <form method="post" action="">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="create">
                            <div class="form-group mb-2">
                                <label for="agentname" class="font-weight-bold text-body mb-1">{{#str}}agent_name, tool_teachermcp{{/str}}</label>
                                <input type="text" name="agentname" id="agentname" class="form-control bg-white" placeholder="{{#str}}agent_name_help, tool_teachermcp{{/str}}" required>
                            </div>
                            <div class="form-group mb-2">
                                <label for="scope_preset" class="font-weight-bold text-body mb-1">{{#str}}scope_preset, tool_teachermcp{{/str}}</label>
                                <select name="scope_preset" id="scope_preset" class="form-control custom-select bg-white" aria-describedby="scopePresetHelp">
                                    <option value="full" selected>{{#str}}scope_preset_full, tool_teachermcp{{/str}}</option>
                                    <option value="grading">{{#str}}scope_preset_grading, tool_teachermcp{{/str}}</option>
                                    <option value="curriculum">{{#str}}scope_preset_curriculum, tool_teachermcp{{/str}}</option>
                                    <option value="readonly">{{#str}}scope_preset_readonly, tool_teachermcp{{/str}}</option>
                                </select>
                                <p id="scopePresetHelp" class="small text-muted mt-1 mb-0">{{#str}}scope_preset_help, tool_teachermcp{{/str}}</p>
                            </div>
                            <div class="form-group mb-3">
                                <label for="validity" class="font-weight-bold text-body mb-1">{{#str}}validity_period, tool_teachermcp{{/str}}</label>
                                <select name="validity" id="validity" class="form-control custom-select bg-white">
                                    {{#validity_options}}
                                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                    {{/validity_options}}
                                </select>
                            </div>
                            {{#has_external_tools}}
                            <fieldset class="form-group mb-3">
                                <legend class="h6 font-weight-bold text-body mb-1">{{#str}}external_tool_grants, tool_teachermcp{{/str}}</legend>
                                <p class="small text-muted mb-2">{{#str}}external_tool_grants_desc, tool_teachermcp{{/str}}</p>
                                {{#external_tools}}
                                <div class="custom-control custom-checkbox mb-1">
                                    <input class="custom-control-input" type="checkbox" name="externaltools[]" value="{{name}}" id="externaltool-{{name}}">
                                    <label class="custom-control-label" for="externaltool-{{name}}">
                                        <code>{{name}}</code><br><span class="small text-muted">{{description}}</span>
                                    </label>
                                </div>
                                {{/external_tools}}
                            </fieldset>
                            {{/has_external_tools}}
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-plus-circle mr-1 me-1"></i>{{#str}}create_token, tool_teachermcp{{/str}}
                            </button>
                        </form>
                    </div>

                    <!-- Tokens List -->
                    {{#has_tokens}}
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0 small">
                            <thead>
                                <tr>
                                    <th>{{#str}}agent_name, tool_teachermcp{{/str}}</th>
                                    <th>Token</th>
                                    <th>{{#str}}lastaccess, tool_teachermcp{{/str}}</th>
                                    <th>{{#str}}status, tool_teachermcp{{/str}}</th>
                                    <th class="text-right text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#tokens}}
                                <tr>
                                    <td class="font-weight-bold align-middle">{{name}}</td>
                                    <td class="align-middle"><code class="tool_teachermcp_token_suffix">...{{lastchars}}</code></td>
                                    <td class="align-middle text-muted">{{lastaccess}}</td>
                                    <td class="align-middle">
                                        {{#status_active}}
                                        <span class="badge badge-success">{{#str}}status_active, tool_teachermcp{{/str}}</span>
                                        {{/status_active}}
                                        {{^status_active}}
                                        <span class="badge badge-secondary">{{#str}}status_revoked, tool_teachermcp{{/str}}</span>
                                        {{/status_active}}
                                    </td>
                                    <td class="align-middle text-right text-end">
                                        {{#status_active}}
                                        <a href="{{revokelink}}" class="btn btn-outline-danger btn-sm py-0 px-2" title="{{#str}}revoke, tool_teachermcp{{/str}}" onclick="return confirm('{{#str}}confirm_revoke, tool_teachermcp{{/str}}');">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                        {{/status_active}}
                                    </td>
                                </tr>
                                {{/tokens}}
                            </tbody>
                        </table>
                    </div>
                    {{/has_tokens}}
                    {{^has_tokens}}
                    <div class="p-4 text-center text-muted">
                        <i class="fa fa-key fa-2x mb-2 text-muted"></i>
                        <p class="mb-0">{{#str}}no_tokens_found, tool_teachermcp{{/str}}</p>
                    </div>
                    {{/has_tokens}}
                </div>
            </div>
        </div>

        <!-- Setup Guides Column -->
        <div class="col-xl-6 mb-4">
            <div class="card h-100 border tool_teachermcp_setup">
                <div class="card-header bg-transparent py-3">
                    <h2 class="h6 mb-0 font-weight-bold text-body">{{#str}}how_to_connect, tool_teachermcp{{/str}}</h2>
                </div>
                <div class="card-body">
                    <ul class="nav nav-tabs mb-3" id="agentTabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="claude-tab" data-toggle="tab" data-bs-toggle="tab" href="#claude" role="tab" aria-controls="claude" aria-selected="true">{{#str}}tab_claude, tool_teachermcp{{/str}}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="chatgpt-tab" data-toggle="tab" data-bs-toggle="tab" href="#chatgpt" role="tab" aria-controls="chatgpt" aria-selected="false">{{#str}}tab_chatgpt, tool_teachermcp{{/str}}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="oauth-tab" data-toggle="tab" data-bs-toggle="tab" href="#oauth" role="tab" aria-controls="oauth" aria-selected="false">{{#str}}oauth_tab_title, tool_teachermcp{{/str}}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="codex-tab" data-toggle="tab" data-bs-toggle="tab" href="#codex" role="tab" aria-controls="codex" aria-selected="false">{{#str}}tab_codex, tool_teachermcp{{/str}}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="resources-tab" data-toggle="tab" data-bs-toggle="tab" href="#resourcestab" role="tab" aria-controls="resourcestab" aria-selected="false">{{#str}}tab_resources, tool_teachermcp{{/str}}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="skill-tab" data-toggle="tab" data-bs-toggle="tab" href="#skilltab" role="tab" aria-controls="skilltab" aria-selected="false">{{#str}}tab_agent_instructions, tool_teachermcp{{/str}}</a>
                        </li>
                    </ul>
                    <div class="tab-content" id="agentTabContent">
                        <!-- Local bridge configuration -->
                        <div class="tab-pane fade" id="oauth" role="tabpanel" aria-labelledby="oauth-tab">
                            <h6 class="font-weight-bold text-dark">{{#str}}oauth_setup_title, tool_teachermcp{{/str}}</h6>
                            <p class="text-body mb-3">{{#str}}oauth_setup_desc, tool_teachermcp{{/str}}</p>

                            <!-- Step 1: Download Bridge -->
                            <div class="p-3 bg-light rounded border mb-3">
                                <h6 class="font-weight-bold text-dark mb-1">
                                    <i class="fa fa-download text-primary mr-1 me-1"></i>{{#str}}download_bridge_title, tool_teachermcp{{/str}}
                                </h6>
                                <p class="text-body mb-2">{{#str}}download_bridge_desc, tool_teachermcp{{/str}}</p>
                                <a href="{{download_bridge_url}}" class="btn btn-sm btn-primary">
                                    <i class="fa fa-download mr-1 me-1"></i>{{#str}}download_bridge_btn, tool_teachermcp{{/str}}
                                </a>
                            </div>

                            <!-- Step 2: Configure Claude Desktop -->
                            <p class="font-weight-bold text-dark mb-1">2. {{#str}}claude_oauth_bridge_desc, tool_teachermcp{{/str}}</p>
                            <pre class="bg-light border rounded p-3 text-break small font-monospace mb-2" id="claudeOAuthConfigBlock"><code>{{config_claude_oauth}}</code></pre>
                            <button type="button" class="btn btn-sm btn-primary mb-3" data-copy-target="claudeOAuthConfigBlock">
                                <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy_config, tool_teachermcp{{/str}}
                            </button>

                            <h6 class="font-weight-bold text-dark mt-3">{{#str}}claude_desktop_title, tool_teachermcp{{/str}}</h6>
                            <p class="text-body mb-3">{{#str}}claude_desktop_desc, tool_teachermcp{{/str}}</p>
                            <p class="font-weight-bold text-dark mb-1">{{#str}}claude_manual_bridge_desc, tool_teachermcp{{/str}}</p>
                            <pre class="bg-light border rounded p-3 text-break small font-monospace mb-2" id="claudeConfigBlock"><code>{{config_claude}}</code></pre>
                            <button type="button" class="btn btn-sm btn-primary mb-3" data-copy-target="claudeConfigBlock">
                                <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy_config, tool_teachermcp{{/str}}
                            </button>

                            <h6 class="font-weight-bold text-dark mt-3">{{#str}}cli_setup_title, tool_teachermcp{{/str}}</h6>
                            <p class="text-body mb-2">{{#str}}cli_setup_desc, tool_teachermcp{{/str}}</p>
                            <div class="d-flex flex-wrap tool_teachermcp_actions mb-3">
                                <a href="https://code.claude.com/docs/en/mcp" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">{{#str}}claude_cli_docs, tool_teachermcp{{/str}}</a>
                                <a href="https://learn.chatgpt.com/docs/extend/mcp" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">{{#str}}codex_cli_docs, tool_teachermcp{{/str}}</a>
                            </div>
                            <div class="border-top pt-2 mt-2">
                                <h6 class="small font-weight-bold text-muted mb-2">{{#str}}oauth_endpoints_title, tool_teachermcp{{/str}}</h6>
                                <div class="small text-muted mb-1">
                                    <strong>{{#str}}oauth_auth_endpoint, tool_teachermcp{{/str}}:</strong><br>
                                    <code>{{oauth_auth_url}}</code>
                                </div>
                                <div class="small text-muted mb-1">
                                    <strong>{{#str}}oauth_token_endpoint, tool_teachermcp{{/str}}:</strong><br>
                                    <code>{{oauth_token_url}}</code>
                                </div>
                                <div class="small text-muted">
                                    <strong>{{#str}}oauth_metadata_endpoint, tool_teachermcp{{/str}}:</strong><br>
                                    <code>{{oauth_meta_url}}</code>
                                </div>
                            </div>
                        </div>

                        <!-- Claude remote app connection -->
                        <div class="tab-pane fade show active" id="claude" role="tabpanel" aria-labelledby="claude-tab">
                            <h6 class="font-weight-bold text-dark">{{#str}}claude_app_title, tool_teachermcp{{/str}}</h6>
                            <p class="text-body mb-3">{{#str}}remote_app_intro, tool_teachermcp{{/str}}</p>
                            <div class="d-flex flex-wrap tool_teachermcp_actions mb-2">
                                <a href="https://claude.ai/customize/connectors" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">{{#str}}open_claude_connectors, tool_teachermcp{{/str}}</a>
                                <a href="claude://claude.ai/new" class="btn btn-sm btn-primary" aria-describedby="claudeAppHelp">{{#str}}open_claude_app, tool_teachermcp{{/str}}</a>
                            </div>
                            <p id="claudeAppHelp" class="text-body mb-3">{{#str}}claude_app_link_help, tool_teachermcp{{/str}}</p>
                            <div class="p-3 bg-light rounded border mb-3">
                                <p class="small font-weight-bold text-dark mb-1">{{#str}}endpoint_url, tool_teachermcp{{/str}}</p>
                                <code id="claudeRemoteEndpoint" class="d-block text-primary mb-2">{{endpoint_url}}</code>
                                <button type="button" class="btn btn-sm btn-primary" data-copy-target="claudeRemoteEndpoint"><i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy_endpoint, tool_teachermcp{{/str}}</button>
                            </div>
                            <ol class="text-body pl-3 ps-3">
                                <li class="mb-2">{{#str}}claude_app_step1, tool_teachermcp{{/str}}</li>
                                <li class="mb-2">{{#str}}claude_app_step2, tool_teachermcp{{/str}}</li>
                                <li class="mb-2">{{#str}}claude_app_step3, tool_teachermcp{{/str}}</li>
                                <li class="mb-2">{{#str}}claude_app_step4, tool_teachermcp{{/str}}</li>
                                <li class="mb-2">{{#str}}claude_app_step5, tool_teachermcp{{/str}}</li>
                            </ol>
                            <p class="text-body">{{#str}}claude_app_workspace, tool_teachermcp{{/str}}</p>
                            <p class="text-body">{{#str}}remote_app_requirements, tool_teachermcp{{/str}}</p>
                            <p class="text-body mb-0">{{#str}}remote_app_cached, tool_teachermcp{{/str}}</p>
                        </div>

                        <!-- HTTP clients Tab -->
                        <div class="tab-pane fade" id="codex" role="tabpanel" aria-labelledby="codex-tab">
                            <h6 class="font-weight-bold text-dark">{{#str}}codex_cursor_title, tool_teachermcp{{/str}}</h6>
                            <p class="text-body mb-2">{{#str}}codex_cursor_desc, tool_teachermcp{{/str}}</p>
                            <p class="text-body mb-3">{{#str}}http_config_cli_note, tool_teachermcp{{/str}}</p>
                            <pre class="bg-light border rounded p-3 text-break small font-monospace mb-2" id="codexConfigBlock"><code>{{config_codex}}</code></pre>
                            <button type="button" class="btn btn-sm btn-primary" data-copy-target="codexConfigBlock">
                                <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy_config, tool_teachermcp{{/str}}
                            </button>
                        </div>

                        <!-- ChatGPT Tab -->
                        <div class="tab-pane fade" id="chatgpt" role="tabpanel" aria-labelledby="chatgpt-tab">
                            <h6 class="font-weight-bold text-dark">{{#str}}chatgpt_title, tool_teachermcp{{/str}}</h6>
                            <p class="text-body mb-3">{{#str}}remote_app_intro, tool_teachermcp{{/str}}</p>
                            <div class="d-flex flex-wrap tool_teachermcp_actions mb-2">
                                <a href="https://chatgpt.com/plugins" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">{{#str}}open_chatgpt_plugins, tool_teachermcp{{/str}}</a>
                                <a href="codex://threads/new" class="btn btn-sm btn-primary" aria-describedby="chatgptAppHelp">{{#str}}open_chatgpt_app, tool_teachermcp{{/str}}</a>
                            </div>
                            <p id="chatgptAppHelp" class="text-body mb-3">{{#str}}chatgpt_app_link_help, tool_teachermcp{{/str}}</p>
                            <div class="p-3 bg-light rounded border mb-3">
                                <p class="small font-weight-bold text-dark mb-1">{{#str}}endpoint_url, tool_teachermcp{{/str}}</p>
                                <code id="chatgptRemoteEndpoint" class="d-block text-primary mb-2">{{endpoint_url}}</code>
                                <button type="button" class="btn btn-sm btn-primary" data-copy-target="chatgptRemoteEndpoint"><i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy_endpoint, tool_teachermcp{{/str}}</button>
                            </div>
                            <ol class="text-body pl-3 ps-3">
                                <li class="mb-2">{{#str}}chatgpt_step1, tool_teachermcp{{/str}}</li>
                                <li class="mb-2">{{#str}}chatgpt_step2, tool_teachermcp{{/str}}</li>
                                <li class="mb-2">{{#str}}chatgpt_step3, tool_teachermcp{{/str}}</li>
                                <li class="mb-2">{{#str}}chatgpt_step4, tool_teachermcp{{/str}}</li>
                                <li class="mb-2">{{#str}}chatgpt_step5, tool_teachermcp{{/str}}</li>
                            </ol>
                            <p class="text-body">{{#str}}chatgpt_remote_access, tool_teachermcp{{/str}}</p>
                            <p class="text-body">{{#str}}remote_app_requirements, tool_teachermcp{{/str}}</p>
                            <p class="text-body mb-0">{{#str}}remote_app_cached, tool_teachermcp{{/str}}</p>
                        </div>

                        <!-- MCP Dynamic Resources Tab -->
                        <div class="tab-pane fade" id="resourcestab" role="tabpanel" aria-labelledby="resources-tab">
                            <h6 class="font-weight-bold text-dark">{{#str}}mcp_resources_title, tool_teachermcp{{/str}}</h6>
                            <p class="text-body mb-3">{{#str}}mcp_resources_desc, tool_teachermcp{{/str}}</p>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover border small mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>URI / Template</th>
                                            <th>Resource</th>
                                            <th>Description</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#mcp_resources}}
                                        <tr>
                                            <td><code class="user-select-all text-primary">{{uri}}</code></td>
                                            <td class="font-weight-bold">{{name}}</td>
                                            <td class="text-muted">{{description}}</td>
                                        </tr>
                                        {{/mcp_resources}}
                                        {{#mcp_resource_templates}}
                                        <tr>
                                            <td><code class="user-select-all text-primary">{{uriTemplate}}</code></td>
                                            <td class="font-weight-bold">{{name}}</td>
                                            <td class="text-muted">{{description}}</td>
                                        </tr>
                                        {{/mcp_resource_templates}}
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- AI Agent Skill & Instructions Tab -->
                        <div class="tab-pane fade" id="skilltab" role="tabpanel" aria-labelledby="skill-tab">
                            <h6 class="font-weight-bold text-dark">{{#str}}agent_skill_title, tool_teachermcp{{/str}}</h6>
                            <p class="text-body mb-3">{{#str}}agent_skill_subtitle, tool_teachermcp{{/str}}</p>

                            <div class="mb-3 d-flex flex-wrap gap-2">
                                <a href="{{download_skill_url}}" class="btn btn-sm btn-primary mr-2 me-2">
                                    <i class="fa fa-download mr-1 me-1"></i>{{#str}}download_skill_file, tool_teachermcp{{/str}}
                                </a>
                                <button type="button" class="btn btn-sm btn-primary" data-copy-target="agentSystemPromptBlock">
                                    <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy_skill_prompt, tool_teachermcp{{/str}}
                                </button>
                            </div>

                            <pre class="bg-light border rounded p-3 text-break small font-monospace" style="max-height: 380px; overflow-y: auto;" id="agentSystemPromptBlock"><code>{{system_prompt_content}}</code></pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Teacher Prompt Library -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border">
                <div class="card-header bg-transparent d-flex flex-wrap justify-content-between align-items-center py-3">
                    <h2 class="h6 mb-0 font-weight-bold text-body">
                        <i class="fa fa-lightbulb mr-2 me-2 text-warning"></i>{{#str}}prompt_library_title, tool_teachermcp{{/str}}
                    </h2>
                    {{#has_courses}}
                    <div class="d-flex flex-wrap align-items-center mt-2 mt-sm-0">
                        <label for="promptCourseFilter" class="small font-weight-bold text-body mr-2 me-2 mb-0">
                            {{#str}}course_filter_label, tool_teachermcp{{/str}}
                        </label>
                        <select id="promptCourseFilter" class="custom-select custom-select-sm form-control form-control-sm bg-white" onchange="window.location.href='?courseid='+this.value;">
                            {{#courses}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{fullname}}</option>
                            {{/courses}}
                        </select>
                    </div>
                    {{/has_courses}}
                </div>
                <div class="card-body">
                    <p class="text-body mb-4">
                        {{#str}}prompt_library_desc, tool_teachermcp{{/str}}
                    </p>

                    <div class="row">
                        {{#prompt_categories}}
                        <div class="col-lg-6 mb-4">
                            <div class="card h-100 border bg-light">
                                <div class="card-header bg-white font-weight-bold d-flex justify-content-between align-items-center py-2">
                                    <span class="text-dark"><i class="fa {{icon}} text-secondary mr-2 me-2"></i>{{category}}</span>
                                    <span class="badge badge-secondary font-weight-normal small">{{badge}}</span>
                                </div>
                                <div class="card-body p-3">
                                    {{#items}}
                                    <div class="mb-3 p-3 bg-white rounded border">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <strong class="text-body">{{title}}</strong>
                                            <button class="btn btn-sm btn-primary py-0 px-2 ml-2 ms-2" type="button" data-prompt="{{prompt}}">
                                                <i class="fa fa-copy mr-1 me-1"></i>{{#str}}copy, tool_teachermcp{{/str}}
                                            </button>
                                        </div>
                                        <p class="text-muted small mb-2">{{description}}</p>
                                        <div class="tool_teachermcp_prompt_text bg-light p-3 rounded text-body border">
                                            "{{prompt}}"
                                        </div>
                                    </div>
                                    {{/items}}
                                </div>
                            </div>
                        </div>
                        {{/prompt_categories}}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Return to course navigation -->
    {{#return_url}}
    <div class="row mt-2 mb-4">
        <div class="col-12">
            <a href="{{return_url}}" class="btn btn-primary">
                <i class="fa fa-arrow-left mr-1 me-1"></i>{{#str}}back_to_course, tool_teachermcp{{/str}}
            </a>
        </div>
    </div>
    {{/return_url}}
</div>
{{#js}}
const dashboard = document.querySelector('.tool_teachermcp_dashboard');
dashboard.querySelectorAll('button[data-copy-target], button[data-prompt]').forEach(button => {
    const label = button.innerHTML;
    let restore;
    button.setAttribute('aria-live', 'polite');
    button.addEventListener('click', async () => {
        clearTimeout(restore);
        button.innerHTML = label;
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        try {
            let text = button.dataset.prompt;
            if (button.dataset.copyTarget) {
                const target = document.getElementById(button.dataset.copyTarget);
                text = target instanceof HTMLInputElement ? target.value : target.innerText;
            }
            await navigator.clipboard.writeText(text);
            button.textContent = dashboard.dataset.copySuccess;
            restore = setTimeout(() => {
                button.innerHTML = label;
            }, 2000);
        } catch {
            button.textContent = dashboard.dataset.copyFailure;
        } finally {
            button.disabled = false;
            button.removeAttribute('aria-busy');
            if (document.activeElement === document.body) {
                button.focus({preventScroll: true});
            }
        }
    });
});
{{/js}}
