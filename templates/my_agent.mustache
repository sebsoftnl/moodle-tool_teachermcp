    @template tool_teachermcp/my_agent
    Teacher connection setup, course tasks and access management.
    Example context (json):
    {
        "registration_disabled": false, "client_claude": true, "client_chatgpt": false,
        "selected_client": "claude", "new_token": false,
        "endpoint_url": "https://moodle.example.org/admin/tool/teachermcp/endpoint.php",
        "connection_check": {
            "id": "connection-check", "textid": "connectionCheckPrompt", "title": "Connection-check prompt",
            "description": "Check available courses.", "copy_label": "Copy connection-check prompt",
            "copy_target": "connectionCheckPrompt", "prompt": "Check the connection."
        },
        "manual_open": false, "manual_form_url": "/admin/tool/teachermcp/my_agent.php",
        "sesskey": "example-sesskey", "agent_name_placeholder": "Example agent",
        "validity_options": [{"value": 90, "label": "90 days", "selected": true}],
        "has_external_tools": false,
        "download_bridge_url": "/admin/tool/teachermcp/download.php?type=bridge",
        "config_claude_oauth": "Example OAuth configuration", "config_claude": "Example manual configuration",
        "config_codex": "Example HTTP configuration",
        "invalid_course": false, "has_courses": true,
        "course_form_url": "/admin/tool/teachermcp/my_agent.php#teacher-prompts",
        "selected_course": {"id": 2, "fullname": "Example course"},
        "courses": [{"id": 2, "fullname": "Example course", "selected": true}],
        "prompt_categories": [{
            "id": "prompts-context", "category": "Context", "count": 1,
            "items": [{
                "id": "prompt-ingest", "textid": "prompt-ingest-text", "title": "Summarise course",
                "description": "Review course content.", "copy_label": "Copy summarise course prompt",
                "copy_target": false, "prompt": "Summarise this course."
            }]
        }],
        "has_tokens": true, "tokens": [{
            "id": 1, "name": "Example Agent", "lastchars": "1234", "created": "1 January 2026",
            "lastaccess": "2 January 2026", "status_active": true, "status_label": "Active",
            "revokelink": "/admin/tool/teachermcp/my_agent.php?action=revoke&tokenid=1&sesskey=example",
            "details": {"validuntil": "1 March 2026", "permissions": [
                {"name": "read", "description": "Read teaching courses"}
            ]}
        }], "confirm_revoke": "Revoke this connection?", "history": false,
        "tools_count_badge": "1 active tool",
        "mcp_resources": [{"uri": "teachermcp://courses", "name": "Teaching courses", "description": "Course list"}],
        "mcp_resource_templates": [],
        "download_skill_url": "/admin/tool/teachermcp/download.php?type=skill",
        "system_prompt_content": "Example skill instructions",
        "oauth_auth_url": "https://moodle.example.org/admin/tool/teachermcp/oauth/authorize.php",
        "oauth_token_url": "https://moodle.example.org/admin/tool/teachermcp/oauth/token.php",
        "oauth_meta_url": "https://moodle.example.org/admin/tool/teachermcp/oauth/metadata.php",
        "return_url": "/course/view.php?id=2"
    }
}}
<div class="tool_teachermcp_dashboard"
     data-copy-success="{{#str}}copied, tool_teachermcp{{/str}}"
     data-copy-failure="{{#str}}copy_failed, tool_teachermcp{{/str}}">
    <p class="mb-3">{{#str}}dashboard_desc, tool_teachermcp{{/str}}</p>
    <nav class="tool_teachermcp_actions d-flex flex-wrap mb-4" aria-label="{{#str}}dashboard_sections, tool_teachermcp{{/str}}">
        <a href="#teacher-connect" class="btn btn-outline-secondary">{{#str}}dashboard_connect, tool_teachermcp{{/str}}</a>
        <a href="#teacher-prompts" class="btn btn-outline-secondary">{{#str}}dashboard_tasks, tool_teachermcp{{/str}}</a>
        <a href="#teacher-connections" class="btn btn-outline-secondary">{{#str}}dashboard_connections, tool_teachermcp{{/str}}</a>
    </nav>

    {{#new_token}}
    <div class="alert alert-warning mb-4">
        <h2 class="h5">{{#str}}token_created, tool_teachermcp{{/str}}</h2>
        <p>{{#str}}token_warning, tool_teachermcp{{/str}}</p>
        <div class="input-group">
            <input type="text" class="form-control" id="newlyGeneratedToken" value="{{new_token}}" readonly aria-label="{{#str}}col_token, tool_teachermcp{{/str}}">
            <div class="input-group-append">
                <button class="btn btn-primary" type="button" data-copy-target="newlyGeneratedToken">{{#str}}copy_token, tool_teachermcp{{/str}}</button>
            </div>
        </div>
    </div>
    {{/new_token}}

    {{> tool_teachermcp/dashboard_connect}}
    {{> tool_teachermcp/dashboard_prompts}}

    <section id="teacher-connections" class="mb-4 pt-3 border-top">
        <h2 class="h4">{{#str}}dashboard_connections, tool_teachermcp{{/str}}</h2>
        <h3 class="h6 mt-3">{{#str}}tokens_header, tool_teachermcp{{/str}}</h3>
        {{#has_tokens}}{{> tool_teachermcp/connection_table}}{{/has_tokens}}
        {{^has_tokens}}
        <p class="text-muted">{{#str}}no_active_connections, tool_teachermcp{{/str}}</p>
        <p class="text-muted">{{#str}}connection_account_help, tool_teachermcp{{/str}}</p>
        {{/has_tokens}}
        {{#history}}
        <details class="tool_teachermcp_history mt-3">
            <summary class="font-weight-bold">{{#str}}connection_history, tool_teachermcp{{/str}} ({{count}})</summary>
            <p class="text-muted mt-2">{{#str}}connection_history_help, tool_teachermcp{{/str}}</p>
            <a href="{{clear_history_url}}" class="btn btn-outline-secondary btn-sm mb-3">{{#str}}clear_history, tool_teachermcp{{/str}}</a>
            {{> tool_teachermcp/connection_table}}
        </details>
        {{/history}}
    </section>

    {{> tool_teachermcp/dashboard_reference}}
    {{#return_url}}<p class="mt-4"><a href="{{return_url}}">{{#str}}back_to_course, tool_teachermcp{{/str}}</a></p>{{/return_url}}
</div>
{{> tool_teachermcp/connection_modals}}
{{#js}}
const dashboard = document.querySelector('.tool_teachermcp_dashboard');
require(['jquery'], function($) {
    $(dashboard).on('shown.bs.tab', '#agentTabs [data-client]', event => {
        dashboard.querySelectorAll('[data-workspace-client]').forEach(help => {
            help.hidden = help.dataset.workspaceClient !== event.target.dataset.client;
        });
    });
});
dashboard.querySelectorAll('form[data-preserve-client]').forEach(form => {
    form.addEventListener('submit', () => {
        form.elements.client.value = dashboard.querySelector('#agentTabs [aria-selected="true"]').dataset.client;
    });
});
const courseForm = dashboard.querySelector('#promptCourseForm');
if (courseForm) {
    courseForm.querySelector('select').addEventListener('change', () => courseForm.requestSubmit());
}
dashboard.querySelectorAll('button[data-copy-target], button[data-prompt]').forEach(button => {
    const label = button.innerHTML;
    let restore;
    button.setAttribute('aria-live', 'polite');
    button.addEventListener('click', async () => {
        clearTimeout(restore);
        button.innerHTML = label;
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        try {
            let text = button.dataset.prompt;
            if (button.dataset.copyTarget) {
                const target = document.getElementById(button.dataset.copyTarget);
                if (target instanceof HTMLInputElement) {
                    text = target.value;
                } else if (target.tagName === 'CODE') {
                    text = target.textContent;
                } else {
                    text = target.innerText;
                }
            }
            await navigator.clipboard.writeText(text);
            button.textContent = dashboard.dataset.copySuccess;
            restore = setTimeout(() => {
                button.innerHTML = label;
            }, 2000);
        } catch {
            button.textContent = dashboard.dataset.copyFailure;
        } finally {
            button.disabled = false;
            button.removeAttribute('aria-busy');
            if (document.activeElement === document.body) {
                button.focus({preventScroll: true});
            }
        }
    });
});
{{/js}}
