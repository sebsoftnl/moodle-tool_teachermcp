{{!
    @template tool_teachermcp/oauth_authorize
    OAuth 2.0 Consent screen for AI Agent connections.
    Example context (json):
    {
        "site_name": "Example Moodle", "client_name": "Example client", "redirect_host": "client.example.org",
        "user_fullname": "Example Teacher", "user_email": "teacher@example.org",
        "permissions": [{"id": "read", "description": "Read teaching courses"}],
        "sesskey": "example-sesskey", "client_id": "example-client",
        "redirect_uri": "https://client.example.org/callback", "state": "example-state",
        "code_challenge": "example-challenge", "code_challenge_method": "S256", "scope": "teachermcp"
    }
}}
<div class="tool_teachermcp_confirmation tool_teachermcp_consent my-3">
    <p class="text-muted">{{site_name}}</p>
    <p>{{#str}}oauth_prompt, tool_teachermcp, {{client_name}}{{/str}}</p>

    <p class="alert alert-info">
        <strong>{{#str}}oauth_third_party_title, tool_teachermcp{{/str}}</strong><br>
        {{#str}}oauth_third_party_notice, tool_teachermcp{{/str}}
    </p>

    {{#redirect_host}}
    <p>{{#str}}oauth_redirect_destination, tool_teachermcp, {{redirect_host}}{{/str}}</p>
    {{/redirect_host}}

    <p>
        <strong>{{user_fullname}}</strong>
        <span class="tool_teachermcp_email">{{user_email}}</span>
    </p>
    <p>{{#str}}oauth_account_scope_notice, tool_teachermcp{{/str}}</p>

    <h2 class="h6 font-weight-bold mb-2">{{#str}}oauth_permissions_header, tool_teachermcp{{/str}}</h2>
    <ul class="pl-3 ps-3 mb-3">
        {{#permissions}}
        <li class="mb-1" data-scope="{{id}}">{{description}}</li>
        {{/permissions}}
        {{^permissions}}
        <li>{{#str}}oauth_perm_none, tool_teachermcp{{/str}}</li>
        {{/permissions}}
    </ul>

    <form method="post" class="mb-3">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="client_id" value="{{client_id}}">
        <input type="hidden" name="redirect_uri" value="{{redirect_uri}}">
        <input type="hidden" name="state" value="{{state}}">
        <input type="hidden" name="code_challenge" value="{{code_challenge}}">
        <input type="hidden" name="code_challenge_method" value="{{code_challenge_method}}">
        <input type="hidden" name="scope" value="{{scope}}">
        <div class="tool_teachermcp_actions d-flex flex-wrap">
            <button type="submit" name="decision" value="deny" class="btn btn-outline-secondary">{{#str}}oauth_deny, tool_teachermcp{{/str}}</button>
            <button type="submit" name="decision" value="allow" class="btn btn-primary">{{#str}}oauth_allow, tool_teachermcp{{/str}}</button>
        </div>
    </form>
    <p class="text-muted">{{#str}}oauth_security_footer, tool_teachermcp{{/str}}</p>
</div>
